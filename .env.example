# MongoDB 连接串
MONGO_URI=mongodb://localhost:27017
# 数据库名
DB_NAME=twilightcup

# HTTP 监听
HOST=0.0.0.0
PORT=8000

# JWT 签名（生产环境务必改成一个随机长串）
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# 日志
LOG_FOLDER=./logs
LOG_LEVEL=INFO

# 默认开始倒计时延迟（秒）
DEFAULT_COUNTDOWN_DELAY=5
