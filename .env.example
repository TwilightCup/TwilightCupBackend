# MongoDB 连接串
MONGO_URI=mongodb://localhost:27017
# 数据库名
DB_NAME=twilightcup

# HTTP 监听
HOST=0.0.0.0
PORT=8000

# JWT 签名（生产环境务必改成一个随机长串）
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# 日志
LOG_FOLDER=./logs
LOG_LEVEL=INFO

# 默认开始倒计时延迟（秒）
DEFAULT_COUNTDOWN_DELAY=5

# 预载门控超时兜底（秒）：双方就绪但预载持续未完成时，超过该时长强制开始回合
PRELOAD_GATE_TIMEOUT=60

# ---- 对象存储（MinIO / SeaweedFS 等 S3 兼容网关）----
# 端点 host:port，不带协议前缀（S3_SECURE 控制 http/https）
S3_ENDPOINT=localhost:9000
# 凭证：网关匿名开放时两行都留空（不签名请求）
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=twilightcup
S3_SECURE=false
# 公开访问基址：直连模式含 bucket；nginx 反代模式指向同域前缀（nginx 转发时补 bucket）
S3_PUBLIC_BASE_URL=http://localhost:9000/twilightcup
